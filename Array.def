#ifndef T
#error "define T before including Array.def"
#endif

#include <stddef.h>
#include <stdlib.h>

#define ARRAY_DEF_CAT_(base, suff) base ## suff
#define ARRAY_DEF_BUF_(base, suff) ARRAY_DEF_CAT_(base, suff)
#define ARRAY_DEF_TYPED_(name) ARRAY_DEF_BUF_(name, T)

typedef struct {
  size_t len;
  T      data[];
} ARRAY_DEF_TYPED_(Array_);


ARRAY_DEF_TYPED_(Array_) *
ARRAY_DEF_TYPED_(createArray_)(size_t len)
{
  if (len > (SIZE_MAX - sizeof(ARRAY_DEF_TYPED_(Array_))) / sizeof(T))
    return NULL; /* Alloc would overflow */


  size_t bytes = sizeof(ARRAY_DEF_TYPED_(Array_)) + len * sizeof(T);
  ARRAY_DEF_TYPED_(Array_) *arr = calloc (1, bytes)
  if (arr == NULL) return NULL;

  arr->len = len;
  return arr;
}


void
ARRAY_DEF_TYPED_(removeArray_)(ARRAY_DEF_TYPED_(Array_) *arr)
{ free(arr); }


void
ARRAY_DEF_TYPED_(fillArray_)(ARRAY_DEF_TYPED_(Array_) *arr, T val)
{
  for (size_t i = 0; i < arr->len; ++i)
    arr->data[i] = val;
}


_Bool
ARRAY_DEF_TYPED_(swapArray_)(ARRAY_DEF_TYPED_(Array_) *arr1, ARRAY_DEF_TYPED_(Array_) *arr2)
{
  if (arr1->len != arr2->len) return 0;
  for (size_t i = 0; i < arr1->len; ++i) {
    const T tmp = arr1->data[i];
    arr1->data[i] = arr2->data[i];
    arr2->data[i] = tmp;
  }
  return 1;
}


T *
ARRAY_DEF_TYPED_(beginArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr)
{ return &arr->data[0]; }


T *
ARRAY_DEF_TYPED_(endArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr)
{ return &arr->data[len - 1]; }


size_t
ARRAY_DEF_TYPED_(sizeArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr)
{ return arr->len; }


_Bool
ARRAY_DEF_TYPED_(emptyArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr)
{ return ARRAY_DEF_TYPED_(sizeArray_)(arr) == 0; }


T
ARRAY_DEF_TYPED_(atArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr, size_t idx)
{
  /* Out-of-bounds index throw */
  if (idx >= arr->len) abort();

  return arr->data[idx];
}


T
ARRAY_DEF_TYPED_(frontArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr)
{ return *ARRAY_DEF_TYPED_(beginArray_)(arr); }


T
ARRAY_DEF_TYPED_(backArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr)
{ return *ARRAY_DEF_TYPED_(endArray_)(arr); }


_Bool
ARRAY_DEF_TYPED_(equalsArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr1, const ARRAY_DEF_TYPED_(Array_) *const arr2)
{
  if (arr1->len != arr2->len) return 0;
  for (size_t i = 0; i < arr1->len; ++i)
    if (arr1->data[i] != arr2->data[i]) return 0;

  return 1;
}


_Bool
ARRAY_DEF_TYPED_(notEqualsArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr1, const ARRAY_DEF_TYPED_(Array_) *const arr2)
{ return !ARRAY_DEF_TYPED_(equalsArray_)(arr1, arr2); }


_Bool
ARRAY_DEF_TYPED_(lessThanArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr1, const ARRAY_DEF_TYPED_(Array_) *const arr2)
{
  if (arr1->len != arr2->len) return 0;
  for (size_t i = 0; i < arr1->len; ++i)
    if (arr1->data[i] < arr2->data[i]) return 1;

  return 0;
}

_Bool
ARRAY_DEF_TYPED_(greaterThanArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr1, const ARRAY_DEF_TYPED_(Array_) *const arr2)
{
  if (arr1->len != arr2->len) return 0;
  for (size_t i = 0; i < arr1->len; ++i)
    if (arr1->data[i] > arr2->data[i]) return 1;

  return 0;
}

_Bool
ARRAY_DEF_TYPED_(lessThanOrEqualToArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr1, const ARRAY_DEF_TYPED_(Array_) *const arr2)
{
  if (arr1->len != arr2->len) return 0;
  return !ARRAY_DEF_TYPED_(greaterThanArray_)(arr1, arr2);
}


_Bool
ARRAY_DEF_TYPED_(greaterThanOrEqualToArray_)(const ARRAY_DEF_TYPED_(Array_) *const arr1, const ARRAY_DEF_TYPED_(Array_) *const arr2)
{
  if (arr1->len != arr2->len) return 0;
  return !ARRAY_DEF_TYPED_(lessThanArray_)(arr1, arr2);
}

#undef ARRAY_DEF_TYPED_
#undef ARRAY_DEF_BUF_
#undef ARRAY_DEF_CAT_
#undef T
